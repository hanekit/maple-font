{
  "$schema": "./source/schema.json",
  "family_name": "Maple UI",
  "use_hinted": true,
  "pool_size": 4,
  "enable_ligature": true,
  "ttfautohint_param": {},
  "github_mirror": "github.com",
  "infinite_arrow": null,
  "remove_tag_liga": false,
  "weight_mapping": {
    "thin": 100,
    "extralight": 200,
    "light": 300,
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "extrabold": 800
  },
  "line_height": 1.0,
  "feature_freeze": {
        "cv01": "enabled",
        "cv02": "enabled",
        "cv03": "disable",
        "cv04": "enabled",
        "cv05": "enabled",
        "cv06": "disable",
        "cv07": "disable",
        "cv08": "disable",
    "cv09": "ignore",
    "cv10": "ignore",
    "cv11": "ignore",
        "cv31": "disable",
        "cv32": "disable",
        "cv33": "disable",
        "cv34": "enabled",
        "cv35": "enabled",
        "cv36": "enabled",
        "cv37": "disable",
        "cv38": "disable",
        "cv39": "disable",
        "cv40": "disable",
        "cv41": "disable",
    "cv42": "ignore",
    "cv43": "ignore",
    "cv44": "ignore",
    "cv61": "ignore",
    "cv62": "ignore",
    "cv63": "ignore",
    "cv64": "ignore",
    "cv65": "ignore",
    "cv66": "ignore",
    "cv96": "ignore",
    "cv97": "ignore",
    "cv98": "ignore",
    "cv99": "ignore",
        "ss01": "disable",
        "ss02": "disable",
        "ss03": "enabled",
        "ss04": "disable",
        "ss05": "enabled",
        "ss06": "disable",
        "ss07": "enabled",
        "ss08": "disable",
        "ss09": "disable",
        "ss10": "disable",
        "ss11": "disable",
        "zero": "disable"
  },
  "nerd_font": {
    "enable": true,
    "version": "3.4.0",
    "mono": false,
    "propo": false,
    "use_font_patcher": false,
    "glyphs": [
      "--complete"
    ],
    "extra_args": []
  },
  "cn": {
    "enable": false,
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": true,
    "use_hinted": false,
    "use_static_base_font": true,
    "scale_factor": 1.0
  }
}
